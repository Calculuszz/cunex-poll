# development | test | staging | production
APP_ENV=development
PORT=4000
# Public origin of the web app; non-GET requests must send this Origin.
APP_ORIGIN=http://localhost:3000
# Public base URL of this API (CUNEX callback / share links point here).
# The web app proxies /api/v1 to this server, so it is the web app's origin.
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=debug

DATABASE_URL=postgres://pollcunex:pollcunex@localhost:55432/pollcunex
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

SESSION_TTL_SECONDS=604800
# HMAC pepper for ballot voter keys. >= 32 chars. Changing it breaks answer editing
# for existing ballots, so keep it in a secret manager in production.
VOTER_KEY_PEPPER=change-me-to-a-long-random-string-0123456789

# Image storage (S3-compatible). These match docker-compose SeaweedFS.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pollcunex-images
S3_ACCESS_KEY_ID=pollcunex
S3_SECRET_ACCESS_KEY=pollcunex-dev-secret
S3_FORCE_PATH_STYLE=true
# CDN base URL for images in production; empty = presigned URLs
S3_PUBLIC_BASE_URL=
IMAGE_MAX_BYTES=5242880

# Login with Google (OAuth client from Google Cloud Console).
# Authorized redirect URI: <API_PUBLIC_URL>/api/v1/auth/google/callback
# Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CUNEX LLE
# mock = fake CUNEX with fixture students (eng-2567, med-2566, arts-2565, admin);
#        log in via /api/v1/auth/cunex/login?mockUser=med-2566
# live = real gateway; the four values below come from the CUNEX team
CUNEX_MODE=mock
CUNEX_GATEWAY_URL=https://culab-svc.azurewebsites.net/Service.svc
CUNEX_LOGIN_URL=
CUNEX_CLIENT_ID=
CUNEX_CLIENT_SECRET=

# CUNEX userIds that become admin on login (comma-separated).
# 100000000000000099 is the mock "admin" fixture.
ADMIN_BOOTSTRAP_CUNEX_IDS=100000000000000099
