# development | test | staging | production
APP_ENV=development
PORT=3000
# Public origin of the web app; non-GET requests must send this Origin.
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

DATABASE_URL=postgres://pollcunex:pollcunex@localhost:5432/pollcunex
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

SESSION_TTL_SECONDS=604800
# HMAC pepper for ballot voter keys. >= 32 chars. Changing it breaks answer editing
# for existing ballots, so keep it in a secret manager in production.
VOTER_KEY_PEPPER=change-me-to-a-long-random-string-0123456789

# CUNEX LLE (values from the CUNEX team)
CUNEX_GATEWAY_URL=https://example.invalid/cunex-gateway
CUNEX_CLIENT_ID=
CUNEX_CLIENT_SECRET=
